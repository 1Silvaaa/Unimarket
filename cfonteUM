<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>UniMarket ERP — Protótipo</title>
        <style>
            :root {
                --navy: #101d38;
                --navy2: #172b50;
                --blue: #2457e8;
                --blue2: #3974ff;
                --bg: #f3f6fc;
                --ink: #192943;
                --muted: #7c8ba5;
                --line: #e7edf5;
                --green: #0eaa70;
                --orange: #e99a22;
                --red: #e34c55;
                --white: #fff;
                --shadow: 0 8px 28px rgba(25,48,86,.06)
            }

            * {
                box-sizing: border-box
            }

            body {
                margin: 0;
                background: var(--bg);
                font: 14px Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
                color: var(--ink)
            }

            button,input,select {
                font: inherit
            }

            button {
                cursor: pointer;
                border: 0
            }

            .app {
                min-height: 100vh;
                display: flex
            }

            .sidebar {
                width: 238px;
                background: linear-gradient(180deg,#101a31,#101d38 75%,#173d83);
                color: #d5deed;
                padding: 22px 14px;
                display: flex;
                flex-direction: column;
                position: fixed;
                inset: 0 auto 0 0;
                z-index: 5
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 2px 9px 28px
            }

            .brandmark {
                width: 39px;
                height: 39px;
                border-radius: 12px;
                background: linear-gradient(145deg,#2d7cff,#123a9e);
                display: grid;
                place-items: center;
                color: white;
                font-weight: 900;
                font-size: 19px
            }

            .brand strong {
                font-size: 20px;
                letter-spacing: -.8px;
                color: #fff
            }

            .brand strong span {
                color: #4c91ff
            }

            .brand small {
                display: block;
                color: #9eb0cf;
                font-size: 8px;
                letter-spacing: 1.2px;
                margin-top: 2px
            }

            .nav-label {
                font-size: 9px;
                letter-spacing: 1.3px;
                color: #7186aa;
                padding: 13px 12px 7px;
                font-weight: 800
            }

            .nav button {
                width: 100%;
                background: transparent;
                color: #b9c7dc;
                padding: 11px 12px;
                border-radius: 9px;
                text-align: left;
                display: flex;
                gap: 12px;
                align-items: center;
                margin: 2px 0;
                font-size: 12px
            }

            .nav button:hover,.nav button.active {
                background: #244780;
                color: white
            }

            .nav .ico {
                width: 17px;
                text-align: center;
                font-size: 15px
            }

            .sidebottom {
                margin-top: auto;
                background: #1b3156;
                border: 1px solid #314a70;
                border-radius: 11px;
                padding: 12px;
                display: flex;
                align-items: center;
                gap: 9px
            }

            .avatar {
                width: 31px;
                height: 31px;
                border-radius: 50%;
                background: #dce8ff;
                color: #2457e8;
                display: grid;
                place-items: center;
                font-weight: 800
            }

            .sidebottom small {
                display: block;
                color: #9fb0ca;
                font-size: 10px
            }

            .main {
                margin-left: 238px;
                width: calc(100% - 238px);
                min-width: 0
            }

            .topbar {
                height: 66px;
                background: #fff;
                border-bottom: 1px solid var(--line);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 4
            }

            .crumb {
                font-size: 11px;
                color: #8a98ad
            }

            .topright {
                display: flex;
                align-items: center;
                gap: 12px
            }

            .company {
                font-size: 11px;
                color: #65748d;
                border: 1px solid var(--line);
                border-radius: 8px;
                padding: 9px 11px
            }

            .iconbtn {
                background: #f4f7fc;
                color: #526581;
                border-radius: 9px;
                padding: 9px 11px
            }

            .content {
                padding: 28px 30px;
                max-width: 1500px;
                margin: auto
            }

            .pagehead {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 23px;
                gap: 14px
            }

            .pagehead h1 {
                font-size: 23px;
                margin: 0 0 5px;
                letter-spacing: -.6px
            }

            .sub {
                color: var(--muted);
                font-size: 12px
            }

            .btn {
                border-radius: 8px;
                padding: 10px 14px;
                font-size: 12px;
                font-weight: 700;
                background: var(--blue);
                color: white;
                box-shadow: 0 3px 8px #2457e825
            }

            .btn:hover {
                background: #1747d0
            }

            .btn.secondary {
                background: #fff;
                color: #40516c;
                border: 1px solid var(--line);
                box-shadow: none
            }

            .btn.danger {
                background: #fff1f1;
                color: #d13f49;
                box-shadow: none
            }

            .btn.small {
                padding: 7px 10px;
                font-size: 11px
            }

            .grid {
                display: grid;
                gap: 15px
            }

            .stats {
                grid-template-columns: repeat(4,minmax(0,1fr));
                margin-bottom: 16px
            }

            .card {
                background: white;
                border: 1px solid var(--line);
                border-radius: 13px;
                padding: 18px;
                box-shadow: var(--shadow);
                min-width: 0
            }

            .stat-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: #8190a7;
                font-size: 11px
            }

            .stat-icon {
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: #edf3ff;
                color: var(--blue);
                display: grid;
                place-items: center
            }

            .stat-value {
                font-size: 24px;
                font-weight: 800;
                letter-spacing: -.7px;
                margin: 12px 0 5px
            }

            .positive {
                color: var(--green);
                font-size: 10px;
                font-weight: 700
            }

            .negative {
                color: var(--red);
                font-size: 10px;
                font-weight: 700
            }

            .two {
                grid-template-columns: 1.2fr 1fr;
                margin-bottom: 16px
            }

            .card-title {
                font-size: 13px;
                font-weight: 800;
                margin: 0 0 16px
            }

            .chart {
                height: 180px;
                display: flex;
                align-items: end;
                gap: 13px;
                padding: 8px 5px 0;
                border-bottom: 1px solid var(--line);
                background: repeating-linear-gradient(to bottom,transparent 0,transparent 43px,#f0f3f8 44px)
            }

            .barcol {
                height: 100%;
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: end;
                align-items: center;
                gap: 7px;
                color: #8593a9;
                font-size: 10px
            }

            .bar {
                width: 100%;
                max-width: 42px;
                border-radius: 6px 6px 2px 2px;
                background: #b9cdf8
            }

            .bar.highlight {
                background: var(--blue)
            }

            .channel {
                margin: 17px 0
            }

            .channel-line {
                display: flex;
                justify-content: space-between;
                font-size: 11px;
                margin-bottom: 7px
            }

            .track {
                height: 7px;
                background: #edf1f7;
                border-radius: 10px;
                overflow: hidden
            }

            .fill {
                height: 100%;
                border-radius: 10px
            }

            .bottomgrid {
                grid-template-columns: 1.8fr 1fr
            }

            .tablewrap {
                overflow: auto
            }

            table {
                border-collapse: collapse;
                width: 100%;
                white-space: nowrap
            }

            th {
                text-align: left;
                font-size: 10px;
                color: #8795aa;
                font-weight: 700;
                padding: 11px 9px;
                border-bottom: 1px solid var(--line)
            }

            td {
                padding: 12px 9px;
                border-bottom: 1px solid #f0f3f8;
                font-size: 11px;
                color: #41516b
            }

            tr:last-child td {
                border: 0
            }

            tbody tr:hover {
                background: #f8faff
            }

            .status {
                display: inline-flex;
                padding: 5px 8px;
                border-radius: 6px;
                font-size: 10px;
                font-weight: 700
            }

            .s-green {
                background: #e7f8f1;
                color: #079b67
            }

            .s-orange {
                background: #fff4e4;
                color: #c77a0b
            }

            .s-red {
                background: #ffeded;
                color: #d34750
            }

            .s-blue {
                background: #eaf1ff;
                color: #2860d8
            }

            .toolbar {
                display: flex;
                gap: 9px;
                flex-wrap: wrap;
                margin-bottom: 16px
            }

            .field {
                border: 1px solid #dfe6f0;
                border-radius: 8px;
                padding: 10px 12px;
                background: #fff;
                color: #34445c;
                outline: none;
                min-width: 0
            }

            .field:focus {
                border-color: #7ca1ff;
                box-shadow: 0 0 0 3px #2457e815
            }

            .search {
                flex: 1;
                min-width: 190px
            }

            .pill {
                border: 1px solid var(--line);
                background: white;
                color: #64738b;
                padding: 9px 12px;
                border-radius: 8px;
                font-size: 11px
            }

            .pill.active {
                background: #eaf1ff;
                border-color: #cbdcff;
                color: #2457e8;
                font-weight: 800
            }

            .productname {
                font-weight: 700;
                color: #253650
            }

            .productmeta {
                font-size: 10px;
                color: #8a98ad;
                margin-top: 4px
            }

            .rowactions {
                display: flex;
                gap: 5px
            }

            .tablebtn {
                background: #edf3ff;
                color: #2457e8;
                padding: 6px 8px;
                border-radius: 6px;
                font-size: 11px
            }

            .alert {
                border: 1px solid #f4dfb9;
                background: #fffaf1;
                color: #91621d;
                padding: 12px;
                border-radius: 9px;
                font-size: 11px;
                margin-bottom: 15px
            }

            .modalback {
                position: fixed;
                inset: 0;
                background: #0b17308c;
                z-index: 20;
                display: none;
                align-items: center;
                justify-content: center;
                padding: 18px
            }

            .modalback.show {
                display: flex
            }

            .modal {
                width: min(560px,100%);
                background: #fff;
                border-radius: 16px;
                padding: 23px;
                box-shadow: 0 25px 80px #07142d45;
                max-height: 90vh;
                overflow: auto
            }

            .modalhead {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 18px
            }

            .modalhead h2 {
                font-size: 18px;
                margin: 0
            }

            .formgrid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 13px
            }

            .formgroup {
                display: flex;
                flex-direction: column;
                gap: 6px
            }

            .formgroup.full {
                grid-column: 1/-1
            }

            .formgroup label {
                font-size: 11px;
                font-weight: 700;
                color: #52617a
            }

            .formgroup input,.formgroup select {
                width: 100%
            }

            .modalfoot {
                display: flex;
                justify-content: flex-end;
                gap: 8px;
                margin-top: 20px
            }

            .toast {
                position: fixed;
                right: 24px;
                bottom: 24px;
                background: #14294b;
                color: #fff;
                padding: 13px 17px;
                border-radius: 10px;
                box-shadow: var(--shadow);
                font-size: 12px;
                z-index: 30;
                display: none
            }

            .toast.show {
                display: block
            }

            .detailgrid {
                grid-template-columns: 1fr 1fr
            }

            .detailrow {
                display: flex;
                justify-content: space-between;
                border-bottom: 1px solid #eff2f7;
                padding: 12px 0;
                font-size: 12px
            }

            .detailrow span:first-child {
                color: #8290a5
            }

            .market-card {
                display: flex;
                align-items: center;
                gap: 13px
            }

            .market-logo {
                width: 43px;
                height: 43px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                font-weight: 900;
                font-size: 16px;
                color: #25334c
            }

            .market-info {
                flex: 1
            }

            .market-info strong {
                font-size: 13px
            }

            .market-info small {
                display: block;
                color: #8996aa;
                margin-top: 4px;
                font-size: 10px
            }

            .toggle {
                accent-color: var(--blue);
                width: 17px;
                height: 17px
            }

            .progress {
                height: 8px;
                border-radius: 10px;
                background: #edf1f7;
                overflow: hidden
            }

            .progress span {
                display: block;
                height: 100%;
                background: var(--blue)
            }

            .donut-wrap {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 26px;
                min-height: 190px;
                flex-wrap: wrap
            }

            .donut {
                width: 154px;
                height: 154px;
                border-radius: 50%;
                background: conic-gradient(#f8c500 0 42%,#ef9a35 42% 70%,#ed6251 70% 88%,#2871e8 88% 100%);
                position: relative;
                flex: none
            }

            .donut:after {
                content: "";
                position: absolute;
                inset: 27px;
                background: #fff;
                border-radius: 50%
            }

            .donut-center {
                position: absolute;
                inset: 0;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                font-weight: 800;
                font-size: 19px
            }

            .donut-center small {
                font-size: 9px;
                color: #8996aa;
                font-weight: 600;
                margin-top: 3px
            }

            .legend {
                min-width: 145px;
                flex: 1;
                max-width: 220px
            }

            .legend-item {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 12px 0;
                font-size: 11px;
                color: #65748b
            }

            .legend-dot {
                width: 9px;
                height: 9px;
                border-radius: 3px;
                flex: none
            }

            .legend-item b {
                margin-left: auto;
                color: #34445c
            }

            .premium-tag {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                background: #f1eaff;
                color: #7850c8;
                border: 1px solid #e4d7ff;
                border-radius: 20px;
                padding: 5px 9px;
                font-size: 9px;
                font-weight: 800;
                letter-spacing: .5px
            }

            .premium-hero {
                background: linear-gradient(120deg,#111e3b,#1d3b73 68%,#315fc2);
                color: #fff;
                border: 0
            }

            .premium-hero .sub {
                color: #c3d2f1
            }

            .premium-hero .stat-value {
                color: #fff
            }

            .finance-kpi {
                font-size: 22px;
                font-weight: 800;
                letter-spacing: -.6px;
                margin: 9px 0 4px
            }

            .dre-table td:last-child,.dre-table th:last-child {
                text-align: right
            }

            .dre-total td {
                font-weight: 800;
                background: #f6f8fc;
                color: #1b2c49
            }

            .dre-positive {
                color: #079b67!important
            }

            .dre-negative {
                color: #d34750!important
            }

            .login {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 1.1fr .9fr;
                background: white
            }

            .loginleft {
                padding: 8vh 10%;
                display: flex;
                flex-direction: column;
                justify-content: center
            }

            .loginright {
                background: linear-gradient(145deg,#07112e,#102d68 65%,#07132f);
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                text-align: center;
                padding: 30px
            }

            .loginright h1 {
                font-size: 48px;
                letter-spacing: -2px;
                margin: 10px
            }

            .loginright p {
                color: #b7c8eb;
                letter-spacing: 2px;
                font-size: 10px
            }

            .loginform {
                max-width: 390px;
                width: 100%;
                margin: auto
            }

            .loginform h2 {
                font-size: 30px;
                margin: 0 0 8px
            }

            .loginform p {
                color: #8492a8;
                font-size: 12px;
                margin-bottom: 28px
            }

            .loginform label {
                display: block;
                font-size: 11px;
                font-weight: 700;
                margin: 15px 0 7px
            }

            .loginform input {
                width: 100%;
                padding: 13px
            }

            .loginform .btn {
                width: 100%;
                margin-top: 20px;
                padding: 13px
            }

            .hidden {
                display: none!important
            }

            @media(max-width: 900px) {
                .sidebar {
                    width:72px;
                    padding: 16px 8px
                }

                .brand {
                    padding: 4px 8px 24px
                }

                .brand>div:last-child,.nav-label,.nav button .navtext,.sidebottom>div:last-child {
                    display: none
                }

                .nav button {
                    justify-content: center;
                    padding: 12px 5px
                }

                .nav button .ico {
                    font-size: 18px
                }

                .sidebottom {
                    justify-content: center;
                    padding: 8px
                }

                .main {
                    margin-left: 72px;
                    width: calc(100% - 72px)
                }

                .stats {
                    grid-template-columns: repeat(2,1fr)
                }

                .content {
                    padding: 20px
                }

                .topbar {
                    padding: 0 20px
                }

                .bottomgrid,.two {
                    grid-template-columns: 1fr
                }
            }

            @media(max-width: 600px) {
                .stats {
                    grid-template-columns:1fr 1fr;
                    gap: 9px
                }

                .stat-value {
                    font-size: 19px
                }

                .content {
                    padding: 16px 12px
                }

                .topbar {
                    height: 56px;
                    padding: 0 12px
                }

                .company {
                    display: none
                }

                .pagehead {
                    align-items: center
                }

                .pagehead h1 {
                    font-size: 19px
                }

                .card {
                    padding: 13px
                }

                .login {
                    grid-template-columns: 1fr
                }

                .loginright {
                    display: none
                }

                .formgrid {
                    grid-template-columns: 1fr
                }

                .formgroup.full {
                    grid-column: auto
                }

                .detailgrid {
                    grid-template-columns: 1fr
                }
            }
        </style>
    </head>
    <body>
        <div id="login" class="login">
            <section class="loginleft">
                <div class="loginform">
                    <div class="brand" style="padding:0 0 35px">
                        <div class="brandmark">U</div>
                        <div>
                            <strong style="color:#10234d">
                                Uni<span style="color:#2457e8">Market</span>
                            </strong>
                            <small style="color:#8290a5">GESTÃO INTELIGENTE DE MARKETPLACES</small>
                        </div>
                    </div>
                    <h2>Bem-vindo de volta!</h2>
                    <p>Centralize suas vendas. Simplifique sua gestão. Multiplique seus resultados.</p>
                    <label>E-mail</label>
                    <input id="email" class="field" type="email" value="admin@unimarket.com.br" placeholder="Digite seu e-mail">
                    <label>Senha</label>
                    <input id="password" class="field" type="password" value="unimarket123" placeholder="Digite sua senha">
                    <button class="btn" onclick="enterApp()">Entrar no UniMarket</button>
                    <p style="text-align:center;margin-top:15px">Acesso demonstrativo: qualquer e-mail e senha.</p>
                </div>
            </section>
            <section class="loginright">
                <div>
                    <div style="font-size:82px">🛒</div>
                    <h1>
                        Uni<span style="color:#2990ff">Market</span>
                    </h1>
                    <p>CENTRALIZE. GERENCIE. VENDA MAIS.</p>
                    <div style="margin-top:65px;color:#8ca7d8;font-size:11px">UM ÚNICO LUGAR PARA TODA A SUA OPERAÇÃO</div>
                </div>
            </section>
        </div>
        <div id="app" class="app hidden">
            <aside class="sidebar">
                <div class="brand">
                    <div class="brandmark">U</div>
                    <div>
                        <strong>
                            Uni<span>Market</span>
                        </strong>
                        <small>ERP MULTICANAL</small>
                    </div>
                </div>
                <nav class="nav" id="nav"></nav>
                <div class="sidebottom">
                    <div class="avatar">JS</div>
                    <div>
                        <strong style="font-size:11px;color:#fff">João Silva</strong>
                        <small>Administrador</small>
                    </div>
                </div>
            </aside>
            <main class="main">
                <header class="topbar">
                    <div>
                        <div style="font-weight:800;font-size:13px" id="topTitle">Dashboard</div>
                        <div class="crumb">
                            UniMarket / <span id="crumb">Visão geral</span>
                        </div>
                    </div>
                    <div class="topright">
                        <span class="company">▣ &nbsp; Empresa demonstração</span>
                        <button class="iconbtn" onclick="notify('Você está em dia! Não há novas notificações.')">♧</button>
                        <div class="avatar">JS</div>
                    </div>
                </header>
                <div class="content" id="content"></div>
            </main>
        </div>
        <div class="modalback" id="modalback" onclick="if(event.target===this)closeModal()">
            <div class="modal" id="modal"></div>
        </div>
        <div class="toast" id="toast"></div>
        <script>
            const navGroups = [["VISÃO GERAL", ["Dashboard"]], ["GESTÃO", ["Produtos", "Pedidos", "Estoque", "Gestão de preços"]], ["CANAIS DE VENDA", ["Marketplaces"]], ["ANÁLISES", ["Relatórios"]], ["MÓDULOS ADICIONAIS", ["DRE Gerencial"]], ["SISTEMA", ["Configurações"]]];
            const icons = {
                "Dashboard": "▦",
                "Produtos": "▣",
                "Pedidos": "🛍",
                "Estoque": "▤",
                "Gestão de preços": "＄",
                "Marketplaces": "▧",
                "Relatórios": "▥",
                "DRE Gerencial": "◒",
