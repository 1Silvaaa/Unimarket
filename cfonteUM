                    html += `<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:15px;flex-wrap:wrap"><div class="sub">Módulo ilustrativo · Integração financeira e contábil não implementada.</div><button class="btn" onclick="notify('Solicitação de demonstração do módulo adicional registrada!')">Conhecer módulo completo ↗</button></div>`;
                } else if (current === "Configurações") {
                    html = pageHead("Configurações", "Personalize sua empresa e gerencie as preferências do UniMarket.");
                    html += `<div class="grid" style="grid-template-columns:1fr 1fr"><section class="card"><h3 class="card-title">Dados da empresa</h3><div class="formgroup"><label>Nome da empresa</label><input class="field" value="UniMarket Comércio Digital Ltda."></div><div class="formgroup" style="margin-top:13px"><label>E-mail administrativo</label><input class="field" value="admin@unimarket.com.br"></div><div class="formgroup" style="margin-top:13px"><label>CNPJ</label><input class="field" value="12.345.678/0001-90"></div><button class="btn" style="margin-top:17px" onclick="notify('Dados da empresa salvos na demonstração.')">Salvar alterações</button></section><section class="card"><h3 class="card-title">Preferências do sistema</h3>${[["Notificações de pedidos", "Receber alertas de novos pedidos."], ["Sincronização automática", "Atualizar dados dos canais conectados."], ["Alertas de estoque baixo", "Avisar quando atingir o estoque mínimo."], ["Resumo diário por e-mail", "Receber resumo da operação."]].map(x => `<div class="detailrow"><div><b>${x[0]}</b><div class="sub" style="margin-top:4px">${x[1]}</div></div><input class="toggle" type="checkbox" checked></div>`).join("")}<button class="btn" style="margin-top:17px" onclick="notify('Preferências salvas!')">Salvar preferências</button></section><section class="card"><h3 class="card-title">Usuários e permissões</h3><div class="detailrow"><span>João Silva</span><b>Administrador</b></div><div class="detailrow"><span>Maria Oliveira</span><b>Operador</b></div><button class="btn secondary" style="margin-top:15px" onclick="notify('Gerenciamento de usuários demonstrativo.')">Gerenciar usuários</button></section><section class="card"><h3 class="card-title">Segurança</h3><div class="detailrow"><span>Autenticação em duas etapas</span><b style="color:var(--green)">Ativa</b></div><div class="detailrow"><span>Último acesso</span><b>Hoje, 09:14</b></div><button class="btn secondary" style="margin-top:15px" onclick="notify('Fluxo de alteração de senha demonstrativo.')">Alterar senha</button></section></div>`;
                }
                c.innerHTML = html;
            }
            function openModal(content) {
                document.getElementById("modal").innerHTML = content;
                document.getElementById("modalback").classList.add("show")
            }
            function closeModal() {
                document.getElementById("modalback").classList.remove("show")
            }
            function openProductModal(p=null) {
                let editing = !!p;
                openModal(`<div class="modalhead"><h2>${editing ? "Editar produto" : "Cadastrar novo produto"}</h2><button class="iconbtn" onclick="closeModal()">✕</button></div><div class="formgrid"><div class="formgroup full"><label>Nome do produto *</label><input class="field" id="pname" value="${p?.name || ""}" placeholder="Ex.: Tênis esportivo"></div><div class="formgroup"><label>SKU *</label><input class="field" id="psku" value="${p?.sku || ""}" placeholder="TEN-100" ${editing ? "readonly" : ""}></div><div class="formgroup"><label>Categoria</label><select class="field" id="pcat">${["Calçados", "Bolsas", "Eletrônicos", "Acessórios", "Vestuário", "Esportes", "Móveis"].map(x => `<option ${p?.category === x ? "selected" : ""}>${x}</option>`).join("")}</select></div><div class="formgroup"><label>Preço de venda (R$) *</label><input class="field" id="pprice" type="number" step=".01" value="${p?.price ?? ""}" placeholder="0,00"></div><div class="formgroup"><label>Estoque inicial</label><input class="field" id="pstock" type="number" value="${p?.stock ?? 0}"></div><div class="formgroup full"><label>Marketplace</label><select class="field" id="pchannel" multiple style="height:92px"><option selected>Mercado Livre</option><option selected>Amazon</option><option>Shopee</option><option>Magalu</option></select><small style="color:#8996aa">Use Ctrl/Cmd para selecionar mais de um canal.</small></div></div><div class="modalfoot"><button class="btn secondary" onclick="closeModal()">Cancelar</button><button class="btn" onclick="saveProduct(${editing ? "true" : "false"})">Salvar produto</button></div>`)
            }
            function saveProduct(editing) {
                let name = document.getElementById("pname").value.trim()
                  , sku = document.getElementById("psku").value.trim()
                  , price = Number(document.getElementById("pprice").value)
                  , stock = Number(document.getElementById("pstock").value);
                if (!name || !sku || !price || stock < 0) {
                    notify("Preencha nome, SKU, preço e estoque corretamente.");
                    return
                }
                let channels = [...document.getElementById("pchannel").selectedOptions].map(o => o.value);
                let p = {
                    name,
                    sku,
                    price,
                    stock,
                    category: document.getElementById("pcat").value,
                    channels,
                    status: stock === 0 ? "Inativo" : stock <= 5 ? "Estoque baixo" : "Ativo"
                };
                if (editing) {
                    let i = products.findIndex(x => x.sku === sku);
                    products[i] = p
                } else {
                    if (products.some(x => x.sku === sku)) {
                        notify("Já existe um produto com esse SKU.");
                        return
                    }
                    products.unshift(p)
                }
                closeModal();
                filter = "Todos";
                query = "";
                renderPage();
                notify(editing ? "Produto atualizado com sucesso!" : "Produto cadastrado com sucesso!")
            }
            function editProduct(sku) {
                let p = products.find(x => x.sku === sku);
                openProductModal(p)
            }
            function openProduct(sku) {
                let p = products.find(x => x.sku === sku);
                selectedProduct = p;
                openModal(`<div class="modalhead"><h2>Detalhes do produto</h2><button class="iconbtn" onclick="closeModal()">✕</button></div><div style="background:#edf3ff;padding:20px;border-radius:12px;text-align:center;font-size:30px">📦</div><h3>${p.name}</h3><div class="sub">SKU ${p.sku} · ${p.category}</div><div class="detailrow"><span>Preço</span><b>${brl(p.price)}</b></div><div class="detailrow"><span>Estoque disponível</span><b>${p.stock} unidades</b></div><div class="detailrow"><span>Status</span><span class="status ${statusClass(p.status)}">${p.status}</span></div><div class="detailrow"><span>Canais</span><b>${p.channels.join(", ")}</b></div><div class="modalfoot"><button class="btn secondary" onclick="closeModal()">Fechar</button><button class="btn" onclick="closeModal();editProduct('${p.sku}')">Editar produto</button></div>`)
            }
            function openOrder(id) {
                let o = orders.find(x => x.id === id);
                selectedOrder = o;
                openModal(`<div class="modalhead"><h2>Pedido ${o.id}</h2><button class="iconbtn" onclick="closeModal()">✕</button></div><div class="detailrow"><span>Cliente</span><b>${o.client}</b></div><div class="detailrow"><span>Marketplace</span><b>${o.market}</b></div><div class="detailrow"><span>Data</span><b>${o.date}</b></div><div class="detailrow"><span>Produto</span><b>${o.product}</b></div><div class="detailrow"><span>Quantidade</span><b>${o.qty}</b></div><div class="detailrow"><span>Valor total</span><b>${brl(o.value)}</b></div><div class="detailrow"><span>Status atual</span><span class="status ${statusClass(o.status)}">${o.status}</span></div><div class="formgroup" style="margin-top:16px"><label>Atualizar status</label><select class="field" id="orderStatus">${["Processando", "Em trânsito", "Entregue", "Cancelado"].map(s => `<option ${s === o.status ? "selected" : ""}>${s}</option>`).join("")}</select></div><div class="modalfoot"><button class="btn secondary" onclick="closeModal()">Fechar</button><button class="btn" onclick="saveOrderStatus('${o.id}')">Salvar status</button></div>`)
            }
            function saveOrderStatus(id) {
                let o = orders.find(x => x.id === id);
                o.status = document.getElementById("orderStatus").value;
                closeModal();
                renderPage();
                notify("Status do pedido atualizado!")
            }
            function openMovement() {
                openModal(`<div class="modalhead"><h2>Movimentação de estoque</h2><button class="iconbtn" onclick="closeModal()">✕</button></div><div class="formgroup"><label>Produto</label><select class="field" id="movsku">${products.map(p => `<option value="${p.sku}">${p.name}</option>`).join("")}</select></div><div class="formgrid" style="margin-top:14px"><div class="formgroup"><label>Tipo</label><select class="field" id="movtype"><option>Entrada</option><option>Saída</option></select></div><div class="formgroup"><label>Quantidade</label><input class="field" id="movqty" type="number" min="1" value="1"></div></div><div class="modalfoot"><button class="btn secondary" onclick="closeModal()">Cancelar</button><button class="btn" onclick="saveMovement()">Confirmar movimentação</button></div>`)
            }
            function saveMovement() {
                let p = products.find(x => x.sku === document.getElementById("movsku").value)
                  , q = Number(document.getElementById("movqty").value)
                  , type = document.getElementById("movtype").value;
                if (!q || q < 1) {
                    notify("Informe uma quantidade válida.");
                    return
                }
                if (type === "Saída" && q > p.stock) {
                    notify("Estoque insuficiente para essa saída.");
                    return
                }
                p.stock += type === "Entrada" ? q : -q;
                p.status = p.stock === 0 ? "Inativo" : p.stock <= 5 ? "Estoque baixo" : "Ativo";
                closeModal();
                renderPage();
                notify("Movimentação registrada com sucesso!")
            }
            function applyPrice() {
                let sku = document.getElementById("priceSku").value
                  , p = products.find(x => x.sku === sku)
                  , price = Number(document.getElementById("newPrice").value);
                if (!price || price <= 0) {
                    notify("Informe um preço válido.");
                    return
                }
                p.price = price;
                notify("Preço atualizado no protótipo. Nenhum canal externo foi alterado.");
                renderPage()
            }
            function renderNav() {
                let el = document.getElementById("nav");
                el.innerHTML = navGroups.map( ([g,items]) => `<div class="nav-label">${g}</div>` + items.map(n => `<button class="${current === n ? "active" : ""}" onclick="go('${n}')"><span class="ico">${icons[n]}</span><span class="navtext">${n}</span></button>`).join("")).join("")
            }
        </script>
    </body>
</html>
